# Java decompilado con jadx (derivado, regenerable: jadx -d decompiled/apk_jadx "Raging Thunder 2 V1.0.16.apk")
/decompiled/apk_jadx/

# Pseudo-C decompilado del/los .so (derivado, regenerable con devrvk/so-decompiler)
/decompiled/*/ghidra/

# Librerías .so propietarias del juego original
lib/*.so
lib/**/*.so
ragingthunder2_extract/lib/

